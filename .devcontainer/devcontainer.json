// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Geonames Server Dev Container",

	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"shutdownAction": "stopCompose",
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/common-utils": {
			"installZsh": "true",
			"installOhMyZsh": "true",
			"configureZshAsDefaultShell": "true",
			"upgradePackages": "true"
		},
		// "ghcr.io/devcontainers-extra/features/uv-tool": {
		// 	"python": "3.12",
		// 	"uv_version": "latest"
		// },
		"ghcr.io/devcontainers-extra/features/uv": {
			"version": "latest"
		},
		// Node builds the web UI in frontend/ (Vite); nothing Node runs in the deployed image.
		"ghcr.io/devcontainers/features/node": {
			"version": "24"
		},
		// gh, authenticated by GH_TOKEN (docker-compose.yml). Pushes go over ssh;
		// the GitHub API (gh repo create, gh pr create) needs the token.
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Docker CLI on the host's Docker (the Mac's socket), for make build-image and
		// make image-check. Images land in the host's Docker. Docker CE: Moby has no
		// Debian trixie packages.
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// 8000 = Supabase Studio + Auth API (kong), 8025 = Mailpit, 3000 = Metabase,
	// 5173 = Vite dev server for the web UI (make ui-dev)
	"forwardPorts": [9500, 5173, 5432, 6379, 8000, 8025, 5050, 3000, 3002, 3003],
	
	// Use 'postCreateCommand' to run commands after the container is created.
	// First ~/.ssh: Docker creates the volume root-owned, so ssh could not write
	// known_hosts (not recursive: the key in it is read-only), and ~/.ssh/config
	// links to .devcontainer/ssh-config, so edits apply without a rebuild.
	// Frontend packages too, once frontend/ has a lockfile.
	"postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" /home/devuser/.ssh && sudo chmod 700 /home/devuser/.ssh && ln -sfn /workspace/.devcontainer/ssh-config /home/devuser/.ssh/config && uv sync && (test ! -f frontend/package-lock.json || npm ci --prefix frontend)",

	// Dev users, one per tier, with known passwords and API keys (see make seed-users).
	// Skipped, not failed, while .env lacks DEV_SEED_USERS or the keys.
	// Also trusts /workspace in the global git config, for shells that do not get
	// the GIT_CONFIG_* environment from docker-compose.yml.
	"postStartCommand": "(git config --global --get-all safe.directory | grep -qxF /workspace || git config --global --add safe.directory /workspace) && make seed-users SEED_ARGS=--skip-unconfigured",
	// "postStartCommand": "bash -c 'nohup uvicorn geonames_server.api.app:app --host 0.0.0.0 --port 9500'",
	
	// Configure tool-specific properties.
	// "customizations": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"donjayamanne.python-extension-pack",
				"ms-python.debugpy",
				"cweijan.vscode-postgresql-client2",
				"ms-ossdata.vscode-pgsql",
				"charliermarsh.ruff",
				"vscjava.migrate-java-to-azure",
				"GitHub.copilot-chat",
				"eamodio.gitlens",
				"waderyan.gitblame",
				"donjayamanne.git-extension-pack",
				"pixl-garden.BongoCat",
				"Anthropic.claude-code",
				"AndrePimenta.claude-code-chat"
			]
		},
		"settings": {
			"python.envFile": "${workspaceFolder}/.devcontainer/.env",
            "python.terminal.useEnvFile": true,
			"[python]": {
				"editor.defaultFormatter": "charliermarsh.ruff"
			}
		}
	},

	"updateRemoteUserUID": true,

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "devuser"
}
