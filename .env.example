POSTGRES_USER = postgres
POSTGRES_PASSWORD = postgres
POSTGRES_HOST = postgres
POSTGRES_PORT = 5432
POSTGRES_DB = geonames

# If you are using your own download server for geonames data, then set the URL here. Otherwise, the default geonames download server will be used.
GEONAMES_URL = "https://download.geonames.org/export/dump/"
ENABLED_DATASETS = cities15000,cities5000,cities1000,cities500,allcountries

LOG_LEVEL = WARNING

FORCE_REBUILD = false

MAX_RESULTS = 1000

SYNC_SCHEDULE_HOURS=3,15