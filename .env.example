# Postgres (Supabase db). Supabase expects database `postgres`; the app connects as `postgres`.
POSTGRES_USER = postgres
POSTGRES_PASSWORD =
POSTGRES_HOST = db
POSTGRES_PORT = 5432
POSTGRES_DB = postgres

# If you are using your own download server for geonames data, then set the URL here. Otherwise, the default geonames download server will be used.
GEONAMES_URL = "https://download.geonames.org/export/dump/"
ENABLED_DATASETS = cities15000,cities5000,cities1000,cities500,allcountries

LOG_LEVEL = WARNING

FORCE_REBUILD = false

MAX_RESULTS = 1000

SYNC_SCHEDULE_HOURS = 3,15

REDIS_URL = redis://redis:6379/0

# Dev only: lets `make seed-users` create users with known passwords and API keys
DEV_SEED_USERS = false

# --- Supabase ---------------------------------------------------------------
# Generate POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, PG_META_CRYPTO_KEY and
# DASHBOARD_PASSWORD with `make supabase-keys` (run once; the keys are signed with JWT_SECRET).
# docker compose refuses to start while any of them is empty.
JWT_SECRET =
ANON_KEY =
SERVICE_ROLE_KEY =
JWT_EXPIRY = 3600
PG_META_CRYPTO_KEY =

# Studio (via kong at SUPABASE_PUBLIC_URL)
DASHBOARD_USERNAME = supabase
DASHBOARD_PASSWORD =
STUDIO_DEFAULT_ORGANIZATION = "Geonames"
STUDIO_DEFAULT_PROJECT = "geonames-server"

# Public URLs as seen from the browser
SUPABASE_PUBLIC_URL = http://localhost:8000
API_EXTERNAL_URL = http://localhost:8000/auth/v1
SITE_URL = http://localhost:9500
ADDITIONAL_REDIRECT_URLS =

# Auth
DISABLE_SIGNUP = false
ENABLE_EMAIL_SIGNUP = true
ENABLE_EMAIL_AUTOCONFIRM = false
MAILER_URLPATHS_CONFIRMATION = "/auth/v1/verify"
MAILER_URLPATHS_INVITE = "/auth/v1/verify"
MAILER_URLPATHS_RECOVERY = "/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE = "/auth/v1/verify"

# SMTP for confirmation and password-reset emails
SMTP_ADMIN_EMAIL = admin@example.com
SMTP_HOST = smtp.example.com
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
SMTP_SENDER_NAME = "Geonames Server"

# OAuth: create apps with callback ${API_EXTERNAL_URL}/callback, then set *_ENABLED = true
GITHUB_ENABLED = false
GITHUB_CLIENT_ID =
GITHUB_SECRET =
GOOGLE_ENABLED = false
GOOGLE_CLIENT_ID =
GOOGLE_SECRET =
