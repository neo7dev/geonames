{
  "version": 1,
  "disable_existing_loggers": false,

  "formatters": {

    "rich_extra": {
      "()": "geonames_server.log.formatters.RichExtraFormatter"
    },

    "json": {
      "()": "geonames_server.log.formatters.MyJSONFormatter",
      "fmt_keys": {
        "timestamp": "timestamp",
        "level": "levelname",
        "logger": "name",
        "module": "module",
        "function": "funcName",
        "line": "lineno",
        "message": "message",
        "thread": "threadName"
      }
    }

  },

  "filters": {

    "only_errors": {
      "()": "geonames_server.log.filters.OnlyErrorsFilter"
    },

    "access": {
      "()": "geonames_server.log.filters.AccessLogFilter"
    },

    "alembic_noise": {
      "()": "geonames_server.log.filters.AlembicNoiseFilter"
    }

  },

  "handlers": {

    "console": {
      "class": "rich.logging.RichHandler",
      "console": "ext://geonames_server.log.console.console",
      "level": "DEBUG",
      "rich_tracebacks": true,
      "tracebacks_show_locals": true,
      "show_time": true,
      "show_level": true,
      "show_path": true,
      "formatter": "rich_extra"
    },

    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "filename": "logs/geonames.jsonl",
      "maxBytes": 102400,
      "backupCount": 5,
      "encoding": "utf-8",
      "formatter": "json",
      "filters": ["only_errors"]
    }

  },

  "loggers": {
    "sqlalchemy.engine": {
      "level": "WARNING",
      "handlers": [],
      "propagate": true
    },
    "uvicorn": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": [],
      "filters": ["access"],
      "propagate": true
    },
    "alembic.runtime.plugins": {
      "level": "WARNING",
      "handlers": [],
      "propagate": true
    },
    "alembic.runtime.migration": {
      "handlers": [],
      "filters": ["alembic_noise"],
      "propagate": true
    },
    "apscheduler": {
      "level": "WARNING",
      "handlers": [],
      "propagate": true
    }
  },

  "root": {
    "level": "INFO",
    "handlers": ["console", "file"]
  }

}
